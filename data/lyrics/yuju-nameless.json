{
  "id": "yuju-nameless",
  "title": "미제 (Nameless)",
  "artist": "YUJU (유주)",
  "lines": [
    {
      "sectionTitle": "Verse",
      "korean": "알잖아",
      "translation": "你明明知道",
      "analysis": [
        {
          "point": "알잖아",
          "explanation": "알다（知道）＋-잖아 的口語終結語尾，表示提醒對方已知的事實，語氣相當於「你知道的」。"
        }
      ]
    },
    {
      "korean": "우리 서로에게 무너지던 그날",
      "translation": "那天我們在彼此面前崩潰",
      "analysis": [
        {
          "point": "우리",
          "explanation": "代名詞「我們」，這裡修飾後面的 서로에게。"
        },
        {
          "point": "서로에게",
          "explanation": "서로（互相）＋-에게（方向助詞），表示「對彼此」。"
        },
        {
          "point": "무너지던",
          "explanation": "무너지다（崩塌）＋-던（過去回想着定語形語尾），表示回想過去持續或反覆的狀態。"
        },
        {
          "point": "그날",
          "explanation": "그（那）＋날（天），名詞「那天」。"
        }
      ]
    },
    {
      "korean": "물이 들어버린 거지",
      "translation": "一切早已覆水難收",
      "analysis": [
        {
          "point": "물이",
          "explanation": "물（水）＋-이（主格助詞）。"
        },
        {
          "point": "들어버린",
          "explanation": "들다（進入/滲入）＋-어 버리다（完結/遺憾補助）＋-ㄴ（定語形語尾），表示水已經湧進來並帶有無可挽回的語氣。"
        },
        {
          "point": "거지",
          "explanation": "것（事實/情況）＋-이지 的口語縮略，表示確認或理所當然的語氣。"
        }
      ]
    },
    {
      "korean": "감당할 수 없을 일을 벌여놓고",
      "translation": "做了無力承擔的事",
      "analysis": [
        {
          "point": "감당할",
          "explanation": "감당하다（承擔）＋-ㄹ（未來定語形語尾），修飾後面的 수。"
        },
        {
          "point": "수 없을",
          "explanation": "수（辦法）＋없다（沒有）＋-을（定語形語尾），表示「無法…的」。"
        },
        {
          "point": "일을",
          "explanation": "일（事情）＋-을（受格助詞）。"
        },
        {
          "point": "벌여놓고",
          "explanation": "벌이다（展開/惹出）＋-어 놓다（保持完成狀態的補助）＋-고（連接詞尾），表示惹出事情後持續該狀態並連接下一句。"
        }
      ]
    },
    {
      "korean": "그 벌을 받고 있지",
      "translation": "如今只能承受代價",
      "analysis": [
        {
          "point": "그",
          "explanation": "冠詞「那」。"
        },
        {
          "point": "벌을",
          "explanation": "벌（懲罰/代價）＋-을（受格助詞）。"
        },
        {
          "point": "받고 있지",
          "explanation": "받다（接受/承受）＋-고 있다（進行）＋-지（終結語尾），表示正在承受並帶確認語氣。"
        }
      ]
    },
    {
      "sectionTitle": "Chorus",
      "korean": "나는 이 관계의 이름을",
      "translation": "這段關係的名字",
      "analysis": [
        {
          "point": "나는",
          "explanation": "나（我）＋-는（主題助詞），口語中常帶對比或引入話題。"
        },
        {
          "point": "이",
          "explanation": "冠詞「這」。"
        },
        {
          "point": "관계의",
          "explanation": "관계（關係）＋-의（屬格助詞）。"
        },
        {
          "point": "이름을",
          "explanation": "이름（名字）＋-을（受格助詞）。"
        }
      ]
    },
    {
      "korean": "붙이지 못한 게 마음이 아파",
      "translation": "始終無法定義 讓我心痛",
      "analysis": [
        {
          "point": "붙이지 못한",
          "explanation": "붙이다（貼上/賦予）＋-지 못하다（無法）＋-ㄴ（定語形語尾），表示「沒能賦予的」。"
        },
        {
          "point": "게",
          "explanation": "것이 的縮略，것（事物/事實）＋-이（主格助詞）。"
        },
        {
          "point": "마음이",
          "explanation": "마음（心）＋-이（主格助詞）。"
        },
        {
          "point": "아파",
          "explanation": "아프다（痛）＋-아（口語終結語尾），表示「痛」。"
        }
      ]
    },
    {
      "korean": "어쩌면 우리 이렇게 영원히",
      "translation": "或許我們就會這樣直到永遠",
      "analysis": [
        {
          "point": "어쩌면",
          "explanation": "副詞「也許/說不定」。"
        },
        {
          "point": "우리",
          "explanation": "代名詞「我們」。"
        },
        {
          "point": "이렇게",
          "explanation": "副詞「這樣」。"
        },
        {
          "point": "영원히",
          "explanation": "副詞「永遠」。"
        }
      ]
    },
    {
      "korean": "부를 수조차 없을 테니까",
      "translation": "或許永遠都無法為這段關係命名",
      "analysis": [
        {
          "point": "부를",
          "explanation": "부르다（稱呼/叫）＋-ㄹ（未來定語形語尾），修飾後面的 수。"
        },
        {
          "point": "수조차",
          "explanation": "수（辦法）＋-조차（助詞，甚至），表示「連辦法都」。"
        },
        {
          "point": "없을",
          "explanation": "없다（沒有）＋-을（定語形語尾），表示「沒有的」。"
        },
        {
          "point": "테니까",
          "explanation": "-ㄹ 터이니까 的縮略，表示推測的原因「因為大概會…」。"
        }
      ]
    },
